@startuml
!theme plain
allowmixing
skinparam backgroundColor #FFFFFF

title Ch06.10: 통신 구조 - 서비스 분리 전략

' ==========================================
' 서비스 분리 전략: Before & After
' ==========================================

package "Before: 모놀리식 아키텍처" {
    component "Monolith Application\n(Port 8080)" as Monolith {
        component "Product Service" as ProductSvc
        component "Order Service" as OrderSvc
        component "Payment Service" as PaymentSvc
    }
    database "Single DB\n(testdb)" as SingleDB {
        entity "orders" as Orders1
        entity "payments" as Payments1
        entity "products" as Products1
    }
    note right of Monolith
        문제점:
        - 모든 서비스가 하나의 DB 공유
        - 커넥션 풀 경쟁
        - 서비스 간 장애 전파
        - 수직 확장만 가능
    end note
}

package "After: MSA 아키텍처" {
    component "Order Service\n(Port 8080)" as OrderService {
        component "Order API" as OrderAPI
        component "PaymentClient\n(WebClient)" as PaymentClient
    }
    database "Order DB\n(orderdb)" as OrderDB {
        entity "orders" as Orders2
    }
    
    component "Payment Service\n(Port 8081)" as PaymentService {
        component "Payment API" as PaymentAPI
    }
    database "Payment DB\n(paymentdb)" as PaymentDB {
        entity "payments" as Payments2
    }
    
    note right of OrderService
        장점:
        - 독립적인 DB
        - 독립적인 커넥션 풀
        - 서비스별 최적화
        - 수평 확장 가능
    end note
}

OrderService --> PaymentService : REST API\n(WebClient)
OrderService --> OrderDB : JPA
PaymentService --> PaymentDB : JPA

@enduml

@startuml
